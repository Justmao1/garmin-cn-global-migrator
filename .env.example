# ==============================================================================
# 佳明中国区 -> 国际区 全量运动与健康数据迁移工具配置文件
# 复制本文件为 .env 并填入你的账号信息：cp .env.example .env
# ==============================================================================

# 1. 佳明中国区账号 (connect.garmin.cn)
GARMIN_CN_USERNAME=your_cn_email@example.com
GARMIN_CN_PASSWORD=your_cn_password

# 2. 佳明国际区账号 (connect.garmin.com)
GARMIN_GLOBAL_USERNAME=your_global_email@example.com
GARMIN_GLOBAL_PASSWORD=your_global_password

# 3. 迁移方向：cn_to_global (默认) 或 global_to_cn
MIGRATE_DIRECTION=cn_to_global

# 4. 速率限制与防风控配置 (单位：秒)
# 每次上传文件之间的间隔秒数（建议 1.5 ~ 3.0 秒，防止触发 Cloudflare 429 限流）
UPLOAD_DELAY_SECONDS=1.5
# 每次下载每日健康数据压缩包之间的间隔秒数
WELLNESS_DAY_DELAY_SECONDS=1.0

# 5. 运动数据迁移附加选项
# 是否在上传 .fit 后自动同步国区自定义的活动名称、备注笔记、收藏星标、比赛类型及力量训练动作组数
SYNC_ACTIVITY_METADATA=true

# 6. 存储路径配置
DATA_DIR=./data
TOKEN_DIR=./data/tokens
LEDGER_DB_PATH=./data/migration_ledger.db
